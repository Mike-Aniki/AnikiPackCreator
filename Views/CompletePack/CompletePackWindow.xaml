<UserControl x:Class="AnikiVisualPackCreator.CompletePackWindow"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBrush}">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SlotTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SlotMeta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="18,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="105"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Width="58"
                               Height="58"
                               Margin="0,0,14,0"
                               Source="/AnikiPackCreator;component/Assets/AppIcon.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource CompleteHeaderTitle}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold"
                                       FontSize="21"/>
                            <TextBlock Text="{DynamicResource CompleteHeaderSubtitle}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{DynamicResource NewProject}"
                                Click="NewProjectClick"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="104"/>
                        <Button Content="{DynamicResource OpenProject}"
                                Click="OpenProjectClick"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="104"
                                Margin="8,0,0,0"/>
                        <Button Content="{DynamicResource SaveProject}"
                                Click="SaveProjectClick"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="104"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <Label Content="{DynamicResource PackName}"/>
                    <TextBox x:Name="PackNameTextBox"
                             Text="{DynamicResource DefaultCompletePackName}"
                             TextChanged="MetadataTextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4">
                    <Label Content="{DynamicResource Author}"/>
                    <TextBox x:Name="AuthorTextBox"
                             TextChanged="MetadataTextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="6">
                    <Label Content="{DynamicResource Version}"/>
                    <TextBox x:Name="VersionTextBox"
                             Text="{DynamicResource DefaultVersion}"
                             TextChanged="MetadataTextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.Column="2"
                            Grid.ColumnSpan="5"
                            Margin="0,10,0,0">
                    <Label Content="{DynamicResource Description}"/>
                    <TextBox x:Name="DescriptionTextBox"
                             TextChanged="MetadataTextChanged"
                             AcceptsReturn="True"
                             MinHeight="54"
                             MaxHeight="68"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.ColumnSpan="3"
                        Style="{StaticResource CardStyle}"
                        Padding="14,11">
                    <TextBlock Text="{DynamicResource CompleteSeparateBehaviorHint}"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource CompleteVisualPack}" Style="{StaticResource SlotTitle}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{DynamicResource Required}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{DynamicResource CompleteVisualHint}" Style="{StaticResource SlotMeta}" Margin="0,8,0,10"/>

                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                            <TextBlock x:Name="VisualNameText" Text="{DynamicResource CompleteNoPackSelected}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock x:Name="VisualMetaText" Text="{DynamicResource CompleteChooseZipHint}" Style="{StaticResource SlotMeta}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{DynamicResource CompleteChooseZip}" Click="ChooseVisualPackClick" MinWidth="116"/>
                            <Button Content="{DynamicResource Clear}" Click="ClearVisualPackClick" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource CompleteLoginPack}" Style="{StaticResource SlotTitle}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{DynamicResource Required}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{DynamicResource CompleteLoginHint}" Style="{StaticResource SlotMeta}" Margin="0,8,0,10"/>

                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                            <TextBlock x:Name="LoginNameText" Text="{DynamicResource CompleteNoPackSelected}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock x:Name="LoginMetaText" Text="{DynamicResource CompleteChooseZipHint}" Style="{StaticResource SlotMeta}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{DynamicResource CompleteChooseZip}" Click="ChooseLoginPackClick" MinWidth="116"/>
                            <Button Content="{DynamicResource Clear}" Click="ClearLoginPackClick" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource CompleteSoundPack}" Style="{StaticResource SlotTitle}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Optional}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{DynamicResource CompleteSoundHint}" Style="{StaticResource SlotMeta}" Margin="0,8,0,10"/>

                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                            <TextBlock x:Name="SoundNameText" Text="{DynamicResource CompleteNoPackSelected}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock x:Name="SoundMetaText" Text="{DynamicResource CompleteOptionalZipHint}" Style="{StaticResource SlotMeta}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{DynamicResource CompleteChooseZip}" Click="ChooseSoundPackClick" MinWidth="116"/>
                            <Button Content="{DynamicResource Clear}" Click="ClearSoundPackClick" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource CompleteColorPack}" Style="{StaticResource SlotTitle}"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Optional}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{DynamicResource CompleteColorHint}" Style="{StaticResource SlotMeta}" Margin="0,8,0,10"/>

                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                            <TextBlock x:Name="ColorNameText" Text="{DynamicResource CompleteNoPackSelected}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock x:Name="ColorMetaText" Text="{DynamicResource CompleteOptionalZipHint}" Style="{StaticResource SlotMeta}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{DynamicResource CompleteChooseZip}" Click="ChooseColorPackClick" MinWidth="116"/>
                            <Button Content="{DynamicResource Clear}" Click="ClearColorPackClick" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{DynamicResource CompleteSummaryTitle}" Style="{StaticResource SectionTitle}"/>

                    <StackPanel Grid.Row="1" Margin="0,2,0,12">
                        <TextBlock x:Name="VisualSummaryText" Margin="0,0,0,8"/>
                        <TextBlock x:Name="LoginSummaryText" Margin="0,0,0,8"/>
                        <TextBlock x:Name="SoundSummaryText" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ColorSummaryText"/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="#FF10171D"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource CompleteInstallBehaviorTitle}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource CompleteInstallBehaviorText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="3"
                               x:Name="StatusTextBlock"
                               Text="{DynamicResource CompleteStatusSelect}"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,12"/>

                    <StackPanel Grid.Row="4">
                        <Button Content="{DynamicResource ExportCompletePackZip}"
                                Click="ExportZipClick"
                                MinHeight="40"/>
                        <Button Content="{DynamicResource ShareCommunityPack}"
                                Click="ShareCommunityPackClick"
                                Style="{StaticResource SecondaryButton}"
                                MinHeight="40"
                                Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
