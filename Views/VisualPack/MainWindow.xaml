<UserControl x:Class="AnikiVisualPackCreator.MainWindow"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBrush}">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SmallValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="PackListScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#FF0E141A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#FF25343E"
                                BorderThickness="1"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track"
                                   Margin="2"
                                   IsDirectionReversed="True"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb MinHeight="44"
                                           Background="#FF31505A">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="#FF3A8592"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="{StaticResource CyanBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="18,14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Width="58"
                               Height="58"
                               Margin="0,0,14,0"
                               Source="/AnikiPackCreator;component/Assets/AppIcon.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource HeaderTitle}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold"
                                       FontSize="21"/>
                            <TextBlock Text="{DynamicResource HeaderSubtitle}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,12,0,0">
                        <Button Content="{DynamicResource NewProject}"
                                Click="NewProjectClick"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="104"/>
                        <Button Content="{DynamicResource OpenProject}"
                                Click="OpenProjectClick"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="104"
                                Margin="8,0,0,0"/>
                        <Button Content="{DynamicResource SaveProject}"
                                Click="SaveProjectClick"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="104"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                    <Label Content="{DynamicResource PackName}"/>
                    <TextBox x:Name="PackNameTextBox"
                             Text="{DynamicResource DefaultPackName}"
                             TextChanged="MetadataTextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4" VerticalAlignment="Center">
                    <Label Content="{DynamicResource Author}"/>
                    <TextBox x:Name="AuthorTextBox"
                             TextChanged="MetadataTextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="6" VerticalAlignment="Center">
                    <Label Content="{DynamicResource Version}"/>
                    <TextBox x:Name="VersionTextBox"
                             Text="{DynamicResource DefaultVersion}"
                             MaxLength="32"
                             TextChanged="MetadataTextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="5" Margin="0,8,0,0">
                    <Label Content="{DynamicResource Description}"/>
                    <TextBox x:Name="DescriptionTextBox"
                             Height="48"
                             MaxLength="300"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="MetadataTextChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{DynamicResource PackImages}" Style="{StaticResource SectionTitle}"/>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Button Content="{DynamicResource FillEmptyViews}"
                                Click="FillMissingClick"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,5"
                                ToolTip="{DynamicResource FillEmptyViewsToolTip}"/>
                    </Grid>

                    <ListBox Grid.Row="2"
                             x:Name="AssetList"
                             ItemsSource="{Binding Assets}"
                             SelectedItem="{Binding SelectedAsset, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}"
                                   BasedOn="{StaticResource PackListScrollBar}"/>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Padding="10,8"
                                                    CornerRadius="6"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FF1A252D"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FF20343D"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF3B8995"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DimensionText}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="6,2"
                                            CornerRadius="3"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FF532A31"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                        <Setter Property="Background" Value="#FF286847"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="9"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedAsset.DisplayName}"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding SelectedAsset.FileName}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedAsset.DimensionText}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="1"
                            x:Name="PreviewHost"
                            Margin="0,14"
                            Background="#FF090C10"
                            BorderBrush="#FF2E3B45"
                            BorderThickness="1"
                            CornerRadius="7"
                            SizeChanged="PreviewHostSizeChanged">
                        <Grid>
                            <Border x:Name="PreviewViewport"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Black"
                                    BorderBrush="#80FFFFFF"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    Cursor="SizeAll"
                                    AllowDrop="True"
                                    MouseLeftButtonDown="PreviewImageMouseDown"
                                    MouseMove="PreviewImageMouseMove"
                                    MouseLeftButtonUp="PreviewImageMouseUp"
                                    MouseWheel="PreviewImageMouseWheel"
                                    DragOver="PreviewImageDragOver"
                                    Drop="PreviewImageDrop">
                                <Grid>
                                    <Image Source="{Binding PreviewBitmap}"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <Image Source="{Binding PreviewOverlayBitmap}"
                                           Stretch="Fill"
                                           IsHitTestVisible="False"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowUiPreview}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <Border HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            Margin="9"
                                            Padding="8,4"
                                            CornerRadius="3"
                                            Background="#B4000000"
                                            IsHitTestVisible="False">
                                        <TextBlock Text="{DynamicResource PreviewDragHint}"
                                                   FontSize="10"
                                                   Foreground="#E5FFFFFF"/>
                                    </Border>
                                </Grid>
                            </Border>

                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Text="{Binding SelectedAsset.Description}"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{DynamicResource ImageSection}" Style="{StaticResource SectionTitle}"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="{DynamicResource SelectImage}"
                                    Click="SelectImageClick"/>
                            <Button Grid.Column="2"
                                    Content="{DynamicResource Clear}"
                                    Click="ClearImageClick"
                                    Style="{StaticResource SecondaryButton}"/>
                        </Grid>

                        <TextBlock Text="{Binding SelectedAsset.SourceFileName}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,14"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="{DynamicResource Zoom}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedAsset.Zoom, StringFormat={}{0:0.00}×}"
                                       Style="{StaticResource SmallValue}"/>
                        </Grid>
                        <Slider Minimum="0.75"
                                Maximum="2"
                                SmallChange="0.05"
                                LargeChange="0.25"
                                TickFrequency="0.05"
                                Value="{Binding SelectedAsset.Zoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="{DynamicResource ResetPositionZoom}"
                                Click="ResetCropClick"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,0,18"/>

                        <Border Background="#FF111B22"
                                BorderBrush="#FF2E3B45"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <CheckBox Content="{DynamicResource ShowUiPreview}"
                                          IsChecked="{Binding ShowUiPreview, Mode=TwoWay}"
                                          Foreground="{StaticResource TextBrush}"
                                          FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource PreviewOnlyNote}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="38"
                                   Margin="0,0,0,8"/>

                        <ProgressBar x:Name="ExportProgressBar"
                                     Minimum="0"
                                     Maximum="14"
                                     Height="8"
                                     Value="{Binding ExportProgress, Mode=OneWay}"
                                     Foreground="{StaticResource CyanBrush}"
                                     Background="#FF0B1116"
                                     Margin="0,0,0,10"/>

                        <Button Content="{DynamicResource ExportVisualPackZip}"
                                Click="ExportZipClick"
                                Background="#FF7A5826"
                                BorderBrush="{StaticResource AccentBrush}"
                                Padding="14,9"/>

                        <Button Content="{DynamicResource ShareCommunityPack}"
                                Click="ShareCommunityPackClick"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,9"
                                Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
