<UserControl x:Class="AnikiVisualPackCreator.SoundPackWindow"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBrush}">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PackListScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#FF0E141A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#FF25343E"
                                BorderThickness="1"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track"
                                   Margin="2"
                                   IsDirectionReversed="True"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb MinHeight="44"
                                           Background="#FF31505A">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="#FF3A8592"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="{StaticResource CyanBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="18,14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Width="58"
                               Height="58"
                               Margin="0,0,14,0"
                               Source="/AnikiPackCreator;component/Assets/AppIcon.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource SoundHeaderTitle}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold"
                                       FontSize="21"/>
                            <TextBlock Text="{DynamicResource SoundHeaderSubtitle}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{DynamicResource NewProject}"
                                Click="NewProjectClick"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="104"/>
                        <Button Content="{DynamicResource OpenProject}"
                                Click="OpenProjectClick"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="104"
                                Margin="8,0,0,0"/>
                        <Button Content="{DynamicResource SaveProject}"
                                Click="SaveProjectClick"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="104"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                    <Label Content="{DynamicResource PackName}"/>
                    <TextBox x:Name="PackNameTextBox"
                             Text="{DynamicResource DefaultSoundPackName}"
                             TextChanged="MetadataTextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4" VerticalAlignment="Center">
                    <Label Content="{DynamicResource Author}"/>
                    <TextBox x:Name="AuthorTextBox"
                             TextChanged="MetadataTextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="6" VerticalAlignment="Center">
                    <Label Content="{DynamicResource Version}"/>
                    <TextBox x:Name="VersionTextBox"
                             Text="{DynamicResource DefaultVersion}"
                             MaxLength="32"
                             TextChanged="MetadataTextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="5" Margin="0,8,0,0">
                    <Label Content="{DynamicResource Description}"/>
                    <TextBox x:Name="DescriptionTextBox"
                             Height="48"
                             MaxLength="300"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="MetadataTextChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{DynamicResource SoundSlotsTitle}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Grid.Row="1"
                               Text="{DynamicResource SoundSlotsHint}"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Margin="0,0,0,10"/>

                    <ListBox Grid.Row="2"
                             x:Name="SoundList"
                             ItemsSource="{Binding SoundsView}"
                             SelectedItem="{Binding SelectedSound, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}"
                                   BasedOn="{StaticResource PackListScrollBar}"/>
                        </ListBox.Resources>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,8,0,6"
                                                Padding="2,0,0,5"
                                                BorderBrush="#FF2A3943"
                                                BorderThickness="0,0,0,1">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       FontSize="11"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Padding="10,8"
                                                    CornerRadius="6"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FF1A252D"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#FF20343D"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF3B8995"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CategoryName}"
                                                   Foreground="{StaticResource CyanBrush}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CategoryName}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="6,2"
                                            CornerRadius="3"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FF27313A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReady}" Value="True">
                                                        <Setter Property="Background" Value="#FF286847"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding SelectedSound.DisplayName}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding SelectedSound.ContextName}"
                                   Foreground="{StaticResource CyanBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#FF0E141A"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="24"
                            Margin="0,18"
                            AllowDrop="True"
                            DragOver="SoundDropAreaDragOver"
                            Drop="SoundDropAreaDrop">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="♪"
                                       FontSize="64"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedSound.SourceInfoText}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                                <Button Content="{Binding SelectedSound.SelectButtonText}"
                                        Click="SelectSoundClick"
                                        MinWidth="125"/>
                                <Button Content="{Binding PreviewButtonText}"
                                        Click="PreviewSoundClick"
                                        IsEnabled="{Binding SelectedSound.IsReady}"
                                        Style="{StaticResource SecondaryButton}"
                                        MinWidth="105"
                                        Margin="8,0,0,0"/>
                                <Button Content="{DynamicResource Clear}"
                                        Click="ClearSoundClick"
                                        IsEnabled="{Binding SelectedSound.IsReady}"
                                        Style="{StaticResource SecondaryButton}"
                                        MinWidth="90"
                                        Margin="8,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedSound.DropHintText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="#FF111B22"
                            BorderBrush="#FF2E3B45"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <TextBlock Text="{DynamicResource SoundFallbackNote}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{DynamicResource SoundPackSummary}" Style="{StaticResource SectionTitle}"/>
                        <Border Background="#FF0E141A"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedSoundCountText}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource CyanBrush}"/>
                                <TextBlock Text="{DynamicResource SoundSelectedCountHint}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource SoundFormatTitle}"
                                   FontWeight="SemiBold"
                                   Margin="0,18,0,5"/>
                        <TextBlock Text="{Binding SelectedSound.FormatDescription}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="11"/>

                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="48"
                                   Margin="0,0,0,8"/>

                        <ProgressBar Minimum="0"
                                     Maximum="{Binding Sounds.Count}"
                                     Height="8"
                                     Value="{Binding ExportProgress, Mode=OneWay}"
                                     Foreground="{StaticResource CyanBrush}"
                                     Background="#FF0B1116"
                                     Margin="0,0,0,10"/>

                        <Button Content="{DynamicResource ExportSoundPackZip}"
                                Click="ExportZipClick"
                                Background="#FF7A5826"
                                BorderBrush="{StaticResource AccentBrush}"
                                Padding="14,9"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
