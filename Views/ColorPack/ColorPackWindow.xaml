                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52" Margin="0,0,0,10"/>
