<UserControl x:Class="AnikiVisualPackCreator.ColorPackWindow"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBrush}">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PackListScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#FF0E141A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#FF25343E"
                                BorderThickness="1"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track"
                                   Margin="2"
                                   IsDirectionReversed="True"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb MinHeight="44" Background="#FF31505A">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBorder" Background="{TemplateBinding Background}" CornerRadius="4"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#FF3A8592"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource CyanBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PackListScrollBar}"/>

        <Style x:Key="ColorSwatchButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF60717D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Swatch"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Grid>
                                <Border Margin="3" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="3"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewPlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PreviewPlayBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PreviewPlayBorder" Property="Opacity" Value="0.94"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PreviewPlayBorder" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PreviewPlayBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="PreviewSceneTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="#FF111B22"
                                BorderBrush="#FF2E3B45"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FF18313A"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaletteHexBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="MaxLength" Value="7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="18,14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Width="58"
                               Height="58"
                               Margin="0,0,14,0"
                               Source="/AnikiPackCreator;component/Assets/AppIcon.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource ColorHeaderTitle}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold"
                                       FontSize="21"/>
                            <TextBlock Text="{DynamicResource ColorHeaderSubtitle}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{DynamicResource NewProject}"
                                Click="NewProjectClick"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="104"/>
                        <Button Content="{DynamicResource OpenProject}"
                                Click="OpenProjectClick"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="104"
                                Margin="8,0,0,0"/>
                        <Button Content="{DynamicResource SaveProject}"
                                Click="SaveProjectClick"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="104"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                    <Label Content="{DynamicResource PackName}"/>
                    <TextBox x:Name="PackNameTextBox"
                             Text="{DynamicResource DefaultColorPackName}"
                             TextChanged="MetadataTextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4" VerticalAlignment="Center">
                    <Label Content="{DynamicResource Author}"/>
                    <TextBox x:Name="AuthorTextBox"
                             TextChanged="MetadataTextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="6" VerticalAlignment="Center">
                    <Label Content="{DynamicResource Version}"/>
                    <TextBox x:Name="VersionTextBox"
                             Text="{DynamicResource DefaultVersion}"
                             MaxLength="32"
                             TextChanged="MetadataTextChanged"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="5" Margin="0,8,0,0">
                    <Label Content="{DynamicResource Description}"/>
                    <TextBox x:Name="DescriptionTextBox"
                             Height="48"
                             MaxLength="300"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="MetadataTextChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PackListScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <TextBlock Text="MODE SIMPLIFIÉ" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="Mode expert…" Click="ExpertModeClick" Margin="0,0,6,6"/>
                            <Button Content="Annuler le dernier réglage" Click="UndoPaletteClick" Margin="0,0,0,6"/>
                        </WrapPanel>
                        
                        <TextBlock Text="{DynamicResource ColorPaletteHint}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource ColorGroupAccents}" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" Margin="0,4,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorPrimaryAccent}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_PrimaryAccent}"/>
                            <Button Grid.Column="1" Tag="PrimaryAccent" Style="{StaticResource ColorSwatchButton}" Background="{Binding PrimaryAccentBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="PrimaryAccent" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding PrimaryAccent, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorBadges}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_Badges}"/>
                            <Button Grid.Column="1" Tag="Badges" Style="{StaticResource ColorSwatchButton}" Background="{Binding BadgesBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="Badges" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding Badges, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorActiveButtons}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_ActiveButtons}"/>
                            <Button Grid.Column="1" Tag="ActiveButtons" Style="{StaticResource ColorSwatchButton}" Background="{Binding ActiveButtonsBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="ActiveButtons" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding ActiveButtons, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorOutgoingMessages}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_OutgoingMessages}"/>
                            <Button Grid.Column="1" Tag="OutgoingMessages" Style="{StaticResource ColorSwatchButton}" Background="{Binding OutgoingMessagesBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="OutgoingMessages" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding OutgoingMessages, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>


                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorSecondaryAccent}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_SecondaryAccent}"/>
                            <Button Grid.Column="1" Tag="SecondaryAccent" Style="{StaticResource ColorSwatchButton}" Background="{Binding SecondaryAccentBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="SecondaryAccent" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding SecondaryAccent, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorFocus}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_Focus}"/>
                            <Button Grid.Column="1" Tag="Focus" Style="{StaticResource ColorSwatchButton}" Background="{Binding FocusColorBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="Focus" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding FocusColor, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorActionButtons}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_ActionButtons}"/>
                            <Button Grid.Column="1" Tag="ActionButtons" Style="{StaticResource ColorSwatchButton}" Background="{Binding ActionButtonsColorBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="ActionButtons" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding ActionButtonsColor, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorProgress}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_Progress}"/>
                            <Button Grid.Column="1" Tag="Progress" Style="{StaticResource ColorSwatchButton}" Background="{Binding ProgressColorBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="Progress" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding ProgressColor, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Border BorderBrush="#FF2A3943" BorderThickness="0,1,0,0" Margin="0,0,0,14"/>
                        <TextBlock Text="{DynamicResource ColorGroupInterface}" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorBackground}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_Background}"/>
                            <Button Grid.Column="1" Tag="Background" Style="{StaticResource ColorSwatchButton}" Background="{Binding BackgroundBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="Background" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorBars}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_Bars}"/>
                            <Button Grid.Column="1" Tag="Bars" Style="{StaticResource ColorSwatchButton}" Background="{Binding BarsColorBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="Bars" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding BarsColor, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorMenus}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_Menus}"/>
                            <Button Grid.Column="1" Tag="Menus" Style="{StaticResource ColorSwatchButton}" Background="{Binding MenusColorBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="Menus" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding MenusColor, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorMenuHeader}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_MenuHeader}"/>
                            <Button Grid.Column="1" Tag="MenuHeader" Style="{StaticResource ColorSwatchButton}" Background="{Binding MenuHeaderColorBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="MenuHeader" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding MenuHeaderColor, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorCinematicOverlay}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_CinematicOverlay}"/>
                            <Button Grid.Column="1" Tag="CinematicOverlay" Style="{StaticResource ColorSwatchButton}" Background="{Binding CinematicOverlayColorBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="CinematicOverlay" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding CinematicOverlayColor, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorCards}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_Cards}"/>
                            <Button Grid.Column="1" Tag="Cards" Style="{StaticResource ColorSwatchButton}" Background="{Binding CardsColorBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="Cards" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding CardsColor, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorBorder}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_Border}"/>
                            <Button Grid.Column="1" Tag="Border" Style="{StaticResource ColorSwatchButton}" Background="{Binding BorderColorBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="Border" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding BorderColor, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorNotifications}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_Notifications}"/>
                            <Button Grid.Column="1" Tag="Notifications" Style="{StaticResource ColorSwatchButton}" Background="{Binding NotificationsColorBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="Notifications" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding NotificationsColor, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Border BorderBrush="#FF2A3943" BorderThickness="0,1,0,0" Margin="0,0,0,14"/>
                        <TextBlock Text="{DynamicResource ColorGroupText}" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorPrimaryText}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_PrimaryText}"/>
                            <Button Grid.Column="1" Tag="PrimaryText" Style="{StaticResource ColorSwatchButton}" Background="{Binding PrimaryTextBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="PrimaryText" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding PrimaryText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorSecondaryText}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_SecondaryText}"/>
                            <Button Grid.Column="1" Tag="SecondaryText" Style="{StaticResource ColorSwatchButton}" Background="{Binding SecondaryTextBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="SecondaryText" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding SecondaryText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource ColorHighlightText}" VerticalAlignment="Center" ToolTip="{DynamicResource ColorPreviewImpact_HighlightText}"/>
                            <Button Grid.Column="1" Tag="HighlightText" Style="{StaticResource ColorSwatchButton}" Background="{Binding HighlightTextBrush}" Click="ChooseColorClick"/>
                            <TextBox Grid.Column="3" Tag="HighlightText" GotKeyboardFocus="PaletteFieldGotKeyboardFocus" Style="{StaticResource PaletteHexBox}" Text="{Binding HighlightText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Button Content="{DynamicResource ColorResetPalette}"
                                Click="ResetPaletteClick"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{DynamicResource ColorPreviewTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{DynamicResource ColorPreviewHint}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton x:Name="PreviewMainTab"
                                     GroupName="ColorPreviewScene"
                                     IsChecked="True"
                                     Content="{DynamicResource ColorPreviewTabMain}"
                                     Style="{StaticResource PreviewSceneTab}"/>
                        <RadioButton x:Name="PreviewHubTab"
                                     GroupName="ColorPreviewScene"
                                     Content="{DynamicResource ColorPreviewTabHub}"
