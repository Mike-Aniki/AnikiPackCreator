                        <TextBlock Text="{DynamicResource ColorGeneratedTitle}" FontWeight="SemiBold" Margin="0,4,0,5"/>
                        <TextBlock Text="{Binding GeneratedColorCountText}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11"/>

                        <TextBlock Text="{DynamicResource ColorExportTitle}" FontWeight="SemiBold" Margin="0,18,0,5"/>
                        <TextBlock Text="{DynamicResource ColorExportDescription}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11"/>
