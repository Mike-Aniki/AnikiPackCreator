<UserControl x:Class="AnikiVisualPackCreator.AboutWindow"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBrush}">

    <UserControl.Resources>
        <Style x:Key="AboutCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource AboutCard}" Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Width="84" Height="84"
                       Source="/AnikiPackCreator;component/Assets/AppIcon.png"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="0,0,20,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ANIKI PACK CREATOR"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="26"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="VersionTextBlock"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="13"
                               Margin="0,5,0,0"/>
                    <TextBlock Text="{DynamicResource AboutSubtitle}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,10,30,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource AboutCreatedBy}"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="Mike Aniki"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource AboutCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
<StackPanel Grid.Row="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="760"
                                Margin="30,18,30,34">
                        <TextBlock Text="{DynamicResource HomeWelcomeTitle}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource HomeWelcomeText}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="14"
                                   LineHeight="21"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Stretch"
                                   Margin="0,10,0,20"/>
                        <Button Content="{DynamicResource HomeStartCreating}"
                                Click="StartCreatingClick"
                                HorizontalAlignment="Center"
                                MinWidth="190"
                                MinHeight="40"/>
                    </StackPanel>
<StackPanel Grid.Row="1" x:Name="PackTypesSection">
                        <Border Height="1"
                                Background="{StaticResource BorderBrush}"
                                Margin="0,0,0,18"/>

                        <TextBlock Text="{DynamicResource AboutPackTypesTitle}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource AboutPackTypesHint}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,16"/>

                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AboutVisualTitle}" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource AboutVisualText}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,11"/>

                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AboutSoundTitle}" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource AboutSoundText}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,11"/>

                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AboutColorTitle}" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource AboutColorText}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,11"/>

                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AboutLoginTitle}" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource AboutLoginText}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,11"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AboutCompleteTitle}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="15"/>
                            <TextBlock Grid.Column="1"
                                       Text="{DynamicResource AboutCompleteText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource AboutCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{DynamicResource AboutLinksTitle}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource AboutLinksHint}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,14"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button Content="Discord" Click="DiscordClick" Style="{StaticResource SecondaryButton}" MinHeight="40" Margin="0,0,0,8"/>
                        <Button Content="Ko-fi" Click="KofiClick" Style="{StaticResource SecondaryButton}" MinHeight="40" Margin="0,0,0,8"/>
                        <Button Content="GitHub — Aniki Pack Creator" Click="CreatorGitHubClick" Style="{StaticResource SecondaryButton}" MinHeight="40" Margin="0,0,0,8"/>
                        <Button Content="GitHub — Aniki ReMake" Click="ThemeGitHubClick" Style="{StaticResource SecondaryButton}" MinHeight="40"/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="#FF10171D"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="13"
                            Margin="0,16,0,16"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource AboutCompleteInstallTitle}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource AboutCompleteInstallText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="3"
                               Text="{DynamicResource AboutDisclaimer}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
